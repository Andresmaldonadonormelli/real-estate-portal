# Local development environment for the Real Estate Portal.
# These are the well-known default keys for a local `supabase start` stack
# (derived from the default local JWT secret). They are NOT secrets and only
# work against the local Supabase instance on this machine.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6ImFub24iLCJleHAiOjE5ODM4MTI5OTZ9.CRXP1A7WOeoJeXxjNni43kdQwgnWNReilDMblYTn_I0
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6InNlcnZpY2Vfcm9sZSIsImV4cCI6MTk4MzgxMjk5Nn0.EGIM96RAZx35lJzdJsyH-qQwv8Hdp7fsn3W0YpN81IU

# Plaid (optional). The bank-linking API routes import these; sandbox
# placeholders keep the routes loadable for local development. Replace with real
# Plaid sandbox credentials to exercise the bank-connection flow.
PLAID_ENV=sandbox
PLAID_CLIENT_ID=placeholder
PLAID_SECRET=placeholder
PLAID_TOKEN_ENCRYPTION_KEY=local-dev-plaid-encryption-key-change-me
