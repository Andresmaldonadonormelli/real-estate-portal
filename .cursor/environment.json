{
  "name": "Real Estate Portal",
  "user": "ubuntu",
  "install": "bash .cursor/install.sh",
  "start": "bash .cursor/start.sh",
  "terminals": [
    {
      "name": "next-dev",
      "command": "npm run dev",
      "description": "Next.js dev server for the Real Estate Portal on http://localhost:3000"
    }
  ],
  "ports": [
    { "name": "web", "port": 3000 },
    { "name": "supabase-api", "port": 54321 },
    { "name": "supabase-studio", "port": 54323 }
  ]
}
